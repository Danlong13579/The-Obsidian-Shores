<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/DialogueWindow.uss?fileID=7433441132597879392&amp;guid=44cb6de8dc098a84b84c3b4daa1edd73&amp;type=3#DialogueWindow"/>
    <ui:VisualElement name="ContentContainer" style="flex-grow: 1; flex-direction: column; justify-content: flex-end; align-items: center; align-self: center; align-content: flex-end;">
        <ui:VisualElement name="DialogueContainer" style="flex-grow: 1; height: auto; background-color: rgba(0, 0, 0, 0.624); align-self: flex-end; margin-top: 28px; margin-right: 28px; margin-bottom: 28px; margin-left: 28px; background-image: none; padding-top: 17px; padding-right: 17px; padding-bottom: 17px; padding-left: 17px; background-size: 100% 100%; border-top-left-radius: 42px; border-top-right-radius: 42px; border-bottom-right-radius: 42px; border-bottom-left-radius: 42px; border-left-color: rgb(0, 255, 245); border-right-color: rgb(0, 255, 245); border-top-color: rgb(0, 255, 245); border-bottom-color: rgb(0, 255, 245); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; max-width: 1200px; max-height: 440px; align-items: stretch; justify-content: flex-start;">
            <ui:VisualElement name="HeaderContainer" style="flex-grow: 0; flex-direction: row; padding-top: 0; padding-right: 16px; padding-bottom: 0; padding-left: 16px; height: auto; margin-bottom: 14px;">
                <ui:VisualElement name="SpeakerContainer" class="left">
                    <ui:Label text="Wyzard" name="LeftSpeaker" class="speaker-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="SpeakerContainer" class="center">
                    <ui:Label text="Narrator" name="CenterSpeaker" class="speaker-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="SpeakerContainer" class="right">
                    <ui:Label text="Mayor" name="RightSpeaker" class="speaker-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="BodyContainer" style="flex-grow: 1;">
                <ui:VisualElement name="DialogueTextContainer" enabled="true" style="flex-grow: 1; padding-left: 24px; padding-right: 24px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 42px; border-top-right-radius: 42px; border-bottom-right-radius: 42px; border-bottom-left-radius: 42px; padding-top: 24px; padding-bottom: 24px; display: flex;">
                    <ui:Label text="An endless ocean of blue danced around my waist, and I looked towards the Far Mountains, their peaks stabbing clouds, bleeding them of their snow, the walking silhouettes towering in their mists—and found myself alive. East, beyond the Yaloon Ocean, where the husks and souls of the dead are used to wage war." name="DialogueText" enabled="true" class="dialogue-text" style="overflow: hidden; white-space: normal;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Image source="project://database/Assets/Samples/Graph%20Toolkit/0.4.0-exp.2/VisualNovelDirector%20Sample/Assets/Actors/WirerickPose2.png?fileID=2800000&amp;guid=938e70ce972aab048a4ffac6f77386bb&amp;type=3#WirerickPose2" name="LeftSprite" style="position: absolute; bottom: 0; max-height: 62%; max-width: 33%; left: -100px; right: 22px; top: -250px;"/>
            <AnimatedSprite curvetime="{0,0,2,2,0,0,Free,Free,False,None};{1,1,0,0,0,0,Free,Free,False,None}+(ClampForever,ClampForever)" curve-time="{0,0,1,1,0,0,Auto,Auto,False,None};{1,1,1,1,0,0,Auto,Auto,False,None}+(ClampForever,ClampForever)"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
